{
  "name": "wiki-dnd-parser",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "getCnRepo": "node --import ./loader.js src/getGitRepo.ts",
    "getCnRepo:homebrew": "node --import ./loader.js src/getGitRepo.ts --homebrew",
    "start": "node --import ./loader.js src/prepareData.ts",
    "start:homebrew": "node --import ./loader.js src/prepareData.ts --homebrew",
    "page": "node --import ./loader.js src/prepareData.ts --page && node --import ./loader.js src/generateBookPages.ts",
    "page:homebrew": "node --import ./loader.js src/prepareData.ts --page --homebrew && node --import ./loader.js src/generateBookPages.ts --homebrew",
    "processGenerated": "node --import ./loader.js src/processGenerated.ts",
    "generateContents": "node --import ./loader.js src/generate-contents.ts",
    "generateContents:homebrew": "node --import ./loader.js src/generate-contents.ts --homebrew",
    "splitBooks": "node --import ./loader.js src/split-books.ts",
    "splitBooks:homebrew": "node --import ./loader.js src/split-books.ts --homebrew",
    "listFiles": "node --import ./loader.js src/list-files.ts",
    "generateBookPages": "node --import ./loader.js src/generateBookPages.ts",
    "racetable": "node --import ./loader.js src/generateRaceTable.ts",
    "racetable:homebrew": "node --import ./loader.js src/generateRaceTable.ts --homebrew"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/node": "^20.9.2",
    "@types/xlsx": "^0.0.36",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.3",
    "huijiwiki-api": "^0.7.1",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "xlsx": "^0.18.5"
  }
}
